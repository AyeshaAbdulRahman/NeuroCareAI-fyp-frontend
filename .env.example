# ============================================================================
# NEUROCARE-AI - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env file to git!

# ===== FRONTEND CONFIGURATION =====
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_CHATBOT_API_URL=http://localhost:5001
REACT_APP_ENV=development

# ===== BACKEND CONFIGURATION =====
# Flask Settings
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database Configuration
# ⚠️  IMPORTANT: Choose ONE database option below:
#
# OPTION 1: SQLite (Default - File-based, no server needed)
# DATABASE_URI=sqlite:///neurocare.db
#
# OPTION 2: PostgreSQL (Recommended for Production)
# First, create the database: createdb neurocare_ai
# Then uncomment the line below and fill in credentials:
DATABASE_URI=postgresql://postgres:your_password@localhost:5432/neurocare_ai
# For Heroku PostgreSQL: DATABASE_URI=postgresql://user:password@host:port/dbname
#
# OPTION 3: MySQL
# DATABASE_URI=mysql+pymysql://user:password@localhost:3306/neurocare_ai

# Chat Configuration
CHAT_MAX_MESSAGES_PER_SESSION=50  # Messages before archiving old ones
CHAT_ARCHIVE_ENABLED=True  # Enable automatic archiving
CHATBOT_SERVICE_URL=http://127.0.0.1:5001/chat
CHATBOT_TIMEOUT_SECONDS=90

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# File Upload
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes
ALLOWED_EXTENSIONS=pdf,txt,csv,xlsx,jpg,png,jpeg

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ===== CHATBOT / AGENTIC RAG CONFIGURATION =====
# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small

# Tavily Web Search
TAVILY_API_KEY=your-tavily-api-key-here

# Vector Database
CHROMA_DB_PATH=./.chroma
CHROMA_COLLECTION_NAME=dementia-rag

# LangChain Configuration
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langchain-key
LANGCHAIN_PROJECT=neurocare-dementia

# RAG Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_DOCUMENTS=4
RELEVANCE_THRESHOLD=0.5

# ===== EEG DIAGNOSIS CONFIGURATION =====
EEG_DATA_PATH=./diagnosis/ds004504
MODEL_PATH=./diagnosis/models
OUTPUT_PATH=./diagnosis/outputs

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# ===== SECURITY =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ===== EXTERNAL SERVICES =====
# AWS (if using)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=neurocare-bucket

# ===== DEVELOPMENT TOOLS =====
DEBUG=True
TESTING=False
PROFILE_REQUESTS=False

# ===== DEPLOYMENT =====
ENVIRONMENT=development  # development, staging, production
DOMAIN_NAME=localhost
API_PORT=5000
CHATBOT_PORT=5001

# ===== CACHE =====
CACHE_TYPE=simple  # simple, redis
REDIS_URL=redis://localhost:6379/0

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# ===== MONITORING & ANALYTICS =====
SENTRY_DSN=
TRACKING_ENABLED=False
ANALYTICS_KEY=
