# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development

# Security Keys (change these in production!)
SECRET_KEY=neurocare-secret-key-change-in-production
JWT_SECRET_KEY=neurocare-jwt-secret-key-change-in-production

# Database (SQLite for development)
DATABASE_URI=sqlite:///neurocare.db
# PostgreSQL example (recommended for production):
# DATABASE_URI=postgresql+pg8000://postgres:your_password@localhost:5432/neurocare

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# External chatbot service
CHATBOT_SERVICE_URL=http://127.0.0.1:5001/chat
CHATBOT_TIMEOUT_SECONDS=90
